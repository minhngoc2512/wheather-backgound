[Unit]
Description=Update wallpaper from sun position and weather
After=graphical-session.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/Projects/weather_background/.venv/bin/python %h/Projects/weather_background/wallpaper.py
# Needed so gsettings/qdbus can reach the running desktop session
Environment=DISPLAY=:0
